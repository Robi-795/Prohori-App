<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/ProhoriTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Profile" />

        <FrameLayout
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_avatar">

            <TextView
                android:id="@+id/tv_avatar"
                style="@style/ProhoriTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="P"
                android:textSize="34sp" />
        </FrameLayout>

        <TextView
            android:id="@+id/tv_name"
            style="@style/ProhoriHeading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="Name" />

        <TextView
            android:id="@+id/tv_email"
            style="@style/ProhoriBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="email" />

        <TextView
            android:id="@+id/tv_since"
            style="@style/ProhoriCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:text="" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_settings"
            style="@style/ProhoriOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Settings and privacy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_about"
            style="@style/ProhoriOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="About Prohori" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_logout"
            style="@style/ProhoriOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Log out"
            android:textColor="@color/risk_critical"
            app:strokeColor="@color/risk_critical" />
    </LinearLayout>
</ScrollView>
