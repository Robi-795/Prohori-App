<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="App details"
        app:titleTextColor="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_icon"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:contentDescription="App icon"
                    android:src="@drawable/ic_apps" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_name"
                        style="@style/ProhoriTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="App name"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/tv_package"
                        style="@style/ProhoriCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="package" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge"
                    android:paddingBottom="6dp"
                    android:paddingEnd="14dp"
                    android:paddingStart="14dp"
                    android:paddingTop="6dp"
                    android:text="Safe"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_score"
                    style="@style/ProhoriBody"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Risk score 0 / 100" />
            </LinearLayout>

            <!-- App information -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ProhoriCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/ProhoriHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="App information" />

                    <TextView
                        android:id="@+id/tv_info"
                        style="@style/ProhoriBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Why this rating -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ProhoriCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/ProhoriHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Why this rating" />

                    <TextView
                        android:id="@+id/tv_reasons"
                        style="@style/ProhoriBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Recommended action -->
            <com.google.android.material.card.MaterialCardView
                style="@style/ProhoriCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/ProhoriHeading"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Recommended action" />

                    <TextView
                        android:id="@+id/tv_reco"
                        style="@style/ProhoriBody"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Sensitive permissions -->
            <TextView
                android:id="@+id/tv_perm_title"
                style="@style/ProhoriHeading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Sensitive permissions" />

            <LinearLayout
                android:id="@+id/perm_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/tv_other_perms"
                style="@style/ProhoriCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_settings"
                style="@style/ProhoriButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Open Android app info" />

            <TextView
                style="@style/ProhoriCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginTop="12dp"
                android:text="@string/disclaimer" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
