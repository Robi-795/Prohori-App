<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/ProhoriTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Scan" />

        <TextView
            style="@style/ProhoriCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Check the apps installed on this phone. Prohori never changes or removes any app."
            android:textSize="13sp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/ProhoriCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/ProhoriHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Quick Scan" />

                <TextView
                    style="@style/ProhoriBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Reviews the apps you installed: requested permissions, install source, and whether an accessibility service, keyboard or notification listener is switched on." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_quick"
                    style="@style/ProhoriButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Start Quick Scan" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            style="@style/ProhoriCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/ProhoriHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Deep Inspection" />

                <TextView
                    style="@style/ProhoriBody"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Everything in Quick Scan, plus system apps and the special services each app declares (accessibility, keyboard, notification listener, device admin). Takes longer." />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_deep"
                    style="@style/ProhoriOutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Start Deep Inspection" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_installed"
            style="@style/ProhoriOutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Browse installed apps" />

        <LinearLayout
            android:id="@+id/progress_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ProgressBar
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:indeterminateTint="@color/accent" />

            <TextView
                android:id="@+id/tv_progress"
                style="@style/ProhoriBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Inspecting apps..." />
        </LinearLayout>

        <TextView
            style="@style/ProhoriCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/disclaimer" />
    </LinearLayout>
</ScrollView>
