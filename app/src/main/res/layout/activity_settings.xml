<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/bg"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="Settings"
        app:titleTextColor="@color/text_primary" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <com.google.android.material.card.MaterialCardView
                style="@style/ProhoriCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/sw_notifications"
                        style="@style/ProhoriSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Alert notifications" />

                    <TextView
                        style="@style/ProhoriCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Show a notification when new High or Critical alerts are found or pushed to you." />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/sw_system_apps"
                        style="@style/ProhoriSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Include system apps in Quick Scan" />

                    <TextView
                        style="@style/ProhoriCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Pre-installed apps are usually trusted, so their scores are reduced. Off by default." />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/sw_cloud"
                        style="@style/ProhoriSwitch"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Cloud sync (private account)" />

                    <TextView
                        style="@style/ProhoriCaption"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Saves scan history, alerts and basic device info to your Firebase account. When off, nothing leaves this phone." />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_privacy"
                style="@style/ProhoriOutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Privacy information" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_terms"
                style="@style/ProhoriOutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Terms and conditions" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_cloud"
                style="@style/ProhoriOutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Delete my cloud scan data"
                android:textColor="@color/risk_critical"
                app:strokeColor="@color/risk_critical" />

            <TextView
                style="@style/ProhoriCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Deletes your scan history, alerts and device info from the cloud. Your account stays." />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
