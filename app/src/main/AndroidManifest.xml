<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Needed for Firebase (login, Firestore, push). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: lets Prohori show security alert notifications. Asked with an explanation. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 11+: needed to list ALL installed apps for inspection. Prohori only reads
         app metadata (name, permissions, install source). Note: Google Play restricts this permission. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <application
        android:name=".ProhoriApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Prohori">

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="prohori_alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <activity
            android:name=".activities.SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".activities.LoginActivity" android:exported="false" />
        <activity android:name=".activities.RegisterActivity" android:exported="false" />
        <activity android:name=".activities.ForgotPasswordActivity" android:exported="false" />
        <activity android:name=".activities.MainActivity" android:exported="false" />
        <activity android:name=".activities.ScanResultActivity" android:exported="false" />
        <activity android:name=".activities.InstalledAppsActivity" android:exported="false" />
        <activity android:name=".activities.AppDetailsActivity" android:exported="false" />
        <activity android:name=".activities.AlertDetailsActivity" android:exported="false" />
        <activity android:name=".activities.SettingsActivity" android:exported="false" />
        <activity android:name=".activities.AboutActivity" android:exported="false" />

        <service
            android:name=".notifications.ProhoriMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
